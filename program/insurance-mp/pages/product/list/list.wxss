.product-list-page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background-color: #FFFFFF;
}

.search-bar .van-search {
  flex: 1;
  padding: 16rpx 0 !important;
}

.compare-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  min-width: 80rpx;
}

.compare-toggle text {
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 产品列表 */
.product-list {
  padding: 16rpx 24rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 12rpx;
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 没有更多 */
.no-more {
  padding: 16rpx 48rpx;
}
