.index-page {
  padding-bottom: 32rpx;
}

/* Banner轮播 */
.banner-swiper {
  height: 360rpx;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 区块样式 */
.section {
  margin: 0 24rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.categories-section {
  padding: 16rpx 8rpx;
}

/* 区块头部 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 产品列表 */
.product-list {
  margin-top: 16rpx;
}

/* 分类网格 */
.van-grid-item__content {
  padding: 20rpx 8rpx !important;
}
